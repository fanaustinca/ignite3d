rules_version = '2';
// Ignite3D online CAD files. Everything is public, but the 6-digit access code IS the document id, and
// listing the collection is denied: you can only read or change a file whose code you know.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cad/{code} {
      function validCode() { return code.matches('^[0-9]{6}$'); }
      function validDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'name', 'parts', 'rev', 'by', 'updatedAt', 'createdAt', 'app'])
          && d.data is string && d.data.size() < 1000000
          && d.name is string && d.name.size() <= 80
          && d.parts is int && d.rev is int;
      }
      allow get: if validCode();
      allow list: if false;
      allow create, update: if validCode() && validDoc();
      allow delete: if false;
    }
  }
}
