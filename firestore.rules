rules_version = '2';
// Ignite3D online CAD files. Everything is public, but the 6-digit access code IS the document id, and
// listing is denied: you can only read or change a file whose code you know.
// Custom parts used by a file are stored under a content hash (only reachable from a file that uses them),
// written once and never changed.
service cloud.firestore {
match /databases/{database}/documents {
match /cad/{code} {
function validCode() { return code.matches('^[0-9]{6}$'); }
function validDoc() {
let d = request.resource.data;
return d.keys().hasOnly(['data', 'name', 'parts', 'rev', 'by', 'updatedAt', 'createdAt', 'app', 'custom']) && d.data is string && d.data.size() < 1000000 && d.name is string && d.name.size() <= 80 && d.parts is int && d.rev is int && (!('custom' in d) || (d.custom is map && d.custom.size() <= 200));
}
allow get: if validCode();
allow list: if false;
allow create, update: if validCode() && validDoc();
allow delete: if false;
}
match /customParts/{id} {
function validId() { return id.matches('^[0-9a-f]{32}$'); }
allow get: if validId();
allow list: if false;
allow create: if validId() && request.resource.data.keys().hasOnly(['sku', 'part', 'chunks', 'bytes', 'createdAt']) && request.resource.data.part is string && request.resource.data.part.size() < 900000 && request.resource.data.chunks is int && request.resource.data.chunks <= 12;
allow update, delete: if false;
match /chunks/{n} {
allow get: if validId() && n.matches('^[0-9]{1,2}$');
allow list: if false;
allow create: if validId() && n.matches('^[0-9]{1,2}$') && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
allow update, delete: if false;
}
}
}
}
